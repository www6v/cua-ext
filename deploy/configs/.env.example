# Cua Demo 环境变量配置
# 复制此文件为 .env 并填写必要的值
# cp .env.example .env

# ─── AI 代理 API Keys ───────────────────────────────
# 至少需要一个 API Key 来运行 Demo 3 (AI 代理任务)

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI (GPT)
OPENAI_API_KEY=

# ─── Cua 配置 ──────────────────────────────────────

# 默认沙箱位置: local 或 cloud
# CUA_DEFAULT_ON=local

# 默认沙箱类型: auto, container, vm
# CUA_DEFAULT_KIND=auto

# 默认运行时: auto, gvisor, runc, qemu, lume
# CUA_DEFAULT_RUNTIME=auto

# ─── Docker 配置 ────────────────────────────────────

# Docker 主机（通常无需修改）
# DOCKER_HOST=unix:///var/run/docker.sock

# ─── 遥测 ──────────────────────────────────────────

# 禁用遥测（隐私）
CUA_TELEMETRY_ENABLED=false
LUME_TELEMETRY_ENABLED=false

# ─── Demo 特定配置 ─────────────────────────────────

# Demo 1: 沙箱基础操作
DEMO1_IMAGE=ghcr.io/trycua/linux:24.04
DEMO1_TIMEOUT=60

# Demo 2: 基准测试
DEMO2_TASK=hello_file_env
DEMO2_PARALLEL=1

# Demo 3: AI 代理
DEMO3_HARNESS=claude-code
DEMO3_MODEL=claude-sonnet-4-20250514
DEMO3_TIMEOUT=300

# Demo 4: 流式传输
DEMO4_STREAM_SECONDS=10
DEMO4_OUTPUT_DIR=/tmp/cua-demo4-streaming
